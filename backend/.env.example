# Copy this to .env and fill in real values. Never commit the real .env.

DJANGO_SECRET_KEY=change-me-to-something-random
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,giftchristian.dev

# Leave MYSQL_DATABASE unset to use sqlite (fine for local dev).
# Set it to point the app at your custom server's MySQL instance.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

CORS_ALLOWED_ORIGINS=https://giftchristian.me,https://www.giftchristian.me,http://localhost:8811

# Email: contact form sends to CONTACT_TO_EMAIL via this SMTP account.
# Leave EMAIL_BACKEND on the console backend to just print emails
# to the terminal during local dev instead of actually sending them.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@giftchristian.me
CONTACT_TO_EMAIL=christiangift44@gmail.com
